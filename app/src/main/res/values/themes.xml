<resources>
    <!-- Sin ActionBar y sin AppCompat: la UI es Compose puro.
         La ventana se pinta con el fondo de Zen para evitar un flash claro al arrancar. -->
    <style name="Theme.Zen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zen_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
